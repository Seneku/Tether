#!/bin/sh
# `ue` for bash shells. Claude Code puts the plugin's bin/ on the agent's PATH.
# Git Bash would rewrite Unreal paths such as /Game/Maps/L into C:/Program Files/Git/Game/Maps/L.
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
here="$(dirname "$0")"
for py in python python3; do
  command -v "$py" >/dev/null 2>&1 && exec "$py" "$here/../cli/ue.py" "$@"
done
echo "ue: Python 3 not found on PATH" >&2
exit 2
